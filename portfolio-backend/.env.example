# Copy this file to .env and fill in real values. NEVER commit .env.

# --- MySQL (optional; falls back to local JSON file storage if unset/unreachable) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=portfolio_db

# --- SMTP (Gmail example) ---
# Gmail: use a 16-char App Password, NOT your normal login password.
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Address that receives contact-form submissions (usually same as SMTP_USER)
OWNER_EMAIL=your-gmail-address@gmail.com
# "From" name shown on outgoing emails
MAIL_FROM_NAME=Sunaina Yaseen Portfolio

# --- CORS ---
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---
# Max contact-form submissions per IP per window, e.g. "5 per hour"
CONTACT_RATE_LIMIT=5 per hour

# --- Flask ---
FLASK_DEBUG=false
PORT=5000
